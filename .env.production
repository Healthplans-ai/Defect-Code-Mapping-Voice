# Production build config. Committed on purpose — VITE_API_URL is not a secret:
# it is compiled into the client bundle, so the browser sees it anyway.
#
# Vite loads this file for `vite build` (mode=production) and ignores it during
# `vite dev`, so local development keeps pointing at localhost via .env.
# A VITE_API_URL set in the host's own environment variables (Vercel: Project →
# Settings → Environment Variables) still wins over this file.
VITE_API_URL=https://defect-code-mapping-voice-backend-production.up.railway.app
