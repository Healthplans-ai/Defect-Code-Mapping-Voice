# Base URL of the Defects-Code-Mapping backend, no trailing slash.
#
# Local:  the Backend/ dev server (`npm run dev`).
# Vercel: the Railway service's public domain, set in Project Settings →
#         Environment Variables for every environment you deploy. It is baked
#         into the client bundle at build time, so changing it needs a redeploy.
#
#   VITE_API_URL=https://defects-code-mapping-production.up.railway.app
VITE_API_URL=http://localhost:8787
