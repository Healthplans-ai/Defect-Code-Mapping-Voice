# Local development only. Copy to .env — which is git-ignored, so it never
# leaves your machine.
#
# This does NOT configure a deploy. The deployed API URL is compiled in from
# DEPLOYED_API_URL in src/lib/api.ts, because Vercel does not read committed
# .env files without extra configuration. To override a deploy, set
# VITE_API_URL in the host's own environment variables.
#
# Heads up: Vite loads plain .env in every mode, so a local `npm run build`
# bakes in whatever this says. That is fine for previewing locally.
VITE_API_URL=http://localhost:8787
