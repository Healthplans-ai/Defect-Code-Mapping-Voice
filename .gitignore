# Local env — machine-specific overrides. Copy .env.example to .env.
#
# The deployed API URL is NOT here: it lives in src/lib/api.ts, because Vercel
# does not read committed .env files without extra configuration. Anything
# genuinely secret belongs in the host's environment variables, never in a
# committed file.
.env
.env.local
.env.*.local

